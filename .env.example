# ──────────────────────────────────────────────────────────────
# Discord
# ──────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# From OAuth2 → General → Application ID
DISCORD_CLIENT_ID=

# Optional: a single guild for fast iteration (commands register instantly).
# Leave blank to only deploy global commands.
DISCORD_GUILD_ID=

# ──────────────────────────────────────────────────────────────
# Lavalink (defaults match docker-compose.yml)
# ──────────────────────────────────────────────────────────────
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ──────────────────────────────────────────────────────────────
# Spotify (used by the Lavalink LavaSrc plugin for metadata + ISRC).
# Create an app at https://developer.spotify.com/dashboard.
# These are read by lavalink/application.yml via env substitution.
# ──────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────
# Database (SQLite by default — file lives in ./prisma/dev.db)
# ──────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ──────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
