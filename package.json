{
  "name": "discord-music-bot",
  "version": "2.0.0",
  "description": "Discord music bot powered by Lavalink + LavaSrc (Spotify/Apple Music via ISRC matching).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "deploy:guild": "tsx src/tools/deploy.ts --scope guild --action register",
    "deploy:global": "tsx src/tools/deploy.ts --scope global --action register",
    "clear:guild": "tsx src/tools/deploy.ts --scope guild --action clear",
    "clear:global": "tsx src/tools/deploy.ts --scope global --action clear",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "lavalink:up": "docker compose up -d lavalink",
    "lavalink:down": "docker compose down",
    "lavalink:logs": "docker compose logs -f lavalink"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.24.1",
    "dotenv": "^17.2.3",
    "magmastream": "^2.10.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
